# ==================================================
# REPOMIND ENVIRONMENT CONFIGURATION
# ==================================================

# Environment Mode: development / production
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Google Gemini API Key (Obtain free at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & Vector Database
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage Limits & Timeouts
MAX_REPO_SIZE_MB=100
MAX_INDEXED_FILES=500
MAX_FILE_SIZE_KB=500
CLONE_TIMEOUT_SECONDS=60
INDEXING_TIMEOUT_SECONDS=300

# Abuse Prevention & Rate Limits
MAX_REQUESTS_PER_SESSION=100
MAX_CONCURRENT_INDEXING_JOBS=2
